node_modules
dist

# `coverage` alone did not match `coverage-guests/`, a scratch report directory that a
# `--coverage.reportsDirectory` override produced and a `git add -A` then committed. The
# glob covers any such variant; CI's `prettier --check .` is what noticed, by refusing to
# format the JSON inside it.
coverage
coverage-*/

# Runtime state. An event's photos and database belong to the operator, never to git.
#
# Anchored with a leading slash, and that is load-bearing rather than tidiness. A bare
# `photos/` matches a directory of that name at *any* depth, so these four patterns were
# silently excluding `src/domain/photos/`, `src/application/usecases/photos/` and
# `src/infrastructure/media/` — the photo entity, the upload use cases and the whole
# media adapter. None of it had ever been committed, every `git add` quietly skipped it,
# and a fresh clone would not have built. Keep the slashes.
/data/
/media/
/photos/
/thumbnails/
# Where `npm run backup` writes by default. Same rule, and the same anchoring: an
# archive holds every photo and every password hash.
/backups/

*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

.env
.env.*
!.env.example

# Playwright
playwright-report/
test-results/
tests/e2e/__screenshots__/**/*-actual.png
tests/e2e/__screenshots__/**/*-diff.png

# Baselines exist for one Playwright project, and only one: `test:e2e:visual` pins
# `--project=chromium-desktop`, and the CI visual job counts every committed .png to
# decide whether the harness rendered a complete "before". A run of any other project
# writes its own baselines the first time it meets the @visual specs, and a `git add -A`
# then commits them — which is exactly how eight baselines came to exist for a suite
# that renders four, and how the next pull request's visual job came to fail with a
# broken-harness error that had nothing to do with it.
tests/e2e/__screenshots__/*
!tests/e2e/__screenshots__/chromium-desktop/
blob-report/
.playwright/

# TypeScript incremental build state
*.tsbuildinfo

# TLS material for a local HTTPS run
ssl/*.pem
ssl/*.key
ssl/*.crt

.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
