{
  "name": "eventslide",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted live photo wall for events. Guests upload from their phone with no account, a host moderates, approved photos appear on the projector in real time.",
  "license": "GPL-3.0",
  "author": "Irony42",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Irony42/EventSlide.git"
  },
  "bugs": {
    "url": "https://github.com/Irony42/EventSlide/issues"
  },
  "homepage": "https://github.com/Irony42/EventSlide#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/server/main/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file=scripts/dev.env --clear-screen=false src/main/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:api && npm run build:ops",
    "build:api": "tsc -p tsconfig.build.json",
    "build:ops": "tsc -p tsconfig.ops.json",
    "build:web": "npm run build:client && npm run build:sw",
    "build:client": "vite build --config web/vite.config.ts",
    "build:sw": "vite build --config web/vite.sw.config.ts",
    "build:icons": "tsx scripts/generateIcons.ts",
    "start": "node --env-file-if-exists=.env dist/server/main/index.js",
    "preview": "vite preview --config web/vite.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck:domain && npm run typecheck:server && npm run typecheck:web && npm run typecheck:sw && npm run typecheck:tools",
    "typecheck:domain": "tsc -p tsconfig.domain.json",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck:sw": "tsc -p tsconfig.sw.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project server src/domain src/application",
    "test:server": "vitest run --project server",
    "test:web": "vitest run --project web",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:offline": "playwright test --project=chromium-offline",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:visual": "playwright test --grep @visual --project=chromium-desktop",
    "test:e2e:update-snapshots": "playwright test --grep @visual --project=chromium-desktop --update-snapshots",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts --status",
    "db:seed:demo": "tsx scripts/seedDemo.ts",
    "purge": "tsx scripts/purge.ts",
    "purge:dry-run": "tsx scripts/purge.ts --dry-run",
    "backup": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/backup.ts --verify",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/archiver": "^6.0.4",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
