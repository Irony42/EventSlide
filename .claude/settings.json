{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run verify)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run db:status)",
      "Bash(npm run db:migrate)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx playwright test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/**)",
      "Read(./photos/**)",
      "Read(./thumbnails/**)",
      "Bash(rm -rf photos)",
      "Bash(rm -rf thumbnails)",
      "Bash(rm -rf data)"
    ]
  }
}
