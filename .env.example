# EventSlide configuration.
#
# Copy to `.env` and fill in. Everything here is parsed and validated once by
# src/infrastructure/config/env.ts; nothing else in the codebase reads process.env.
# The server refuses to boot in production if a required secret is missing or weak —
# that refusal is deliberate, do not work around it.

# --- Runtime -----------------------------------------------------------------
# NODE_ENV is deliberately not set here, and **absent means `production`**.
#
# It used to default to `development`, and that single unset variable turned off five
# controls at once: both signing secrets fell back to constants published in this
# repository, the session cookie lost `Secure`, HSTS and `upgrade-insecure-requests`
# stopped being sent, and the CSP admitted `'unsafe-inline'` in `script-src`. A
# self-hosted box started with `npm start` or a systemd unit got all five and said
# nothing about it. Silence now means the strict posture, and the boot refuses rather
# than running weakened.
#
# `compose.yaml` and the `Dockerfile` set `NODE_ENV=production` explicitly, so a Docker
# install never depended on this either way. Development declares itself instead:
# `scripts/dev.env`, which the npm scripts that run from a source checkout load.
PORT=4300
# Public origin, used to build join links and QR codes. Must be the URL a guest's
# phone can actually reach — not localhost, if the phone is on the venue Wi-Fi.
PUBLIC_URL=http://localhost:5173
LOG_LEVEL=debug

# --- Secrets -----------------------------------------------------------------
# Both are required in production — which is what an unset NODE_ENV now means — and must
# be at least 32 characters. Outside production a random secret is generated for each
# boot, so there is no constant in this repository that any configuration can reach; the
# cost is that a restart invalidates every host session and every guest token, and the
# boot log says so. Set them here to keep sessions across a reload.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-in-production-at-least-32-characters
# Signs the event-scoped guest device cookie. Rotating it invalidates every guest
# session, which is the emergency lever if a join link leaks widely.
GUEST_TOKEN_SECRET=change-me-too-at-least-32-characters-long

# --- Cookies -----------------------------------------------------------------
# Leave unset to follow NODE_ENV. Set to true only behind HTTPS, or hosts will be
# unable to log in.
# SESSION_COOKIE_SECURE=false
# Number of reverse proxies in front of the app. 0 when exposed directly; 1 behind a
# single nginx or Caddy. Wrong values break per-IP rate limiting.
TRUST_PROXY_HOPS=0

# --- Storage -----------------------------------------------------------------
DATABASE_PATH=./data/eventslide.sqlite
MEDIA_ROOT=./media
# Where the backup command writes an archive when it is not given --to (default
# ./backups). Not read from this file: the server never uses it, and `npm run backup`
# does not load .env — set it in the command's own environment instead, e.g.
# `BACKUP_DIR=/mnt/usb npm run backup`. The Docker image sets /data/backups, on the
# data volume and so on the same disk as the photos (README, Backups).
# BACKUP_DIR=./backups
# The floor `statfs` must find on the directory holding DATABASE_PATH and on MEDIA_ROOT
# before another upload is admitted (G3-06 / P4-10). Below it: 413 storage.boxFull,
# decided before a single byte is read. Without a separate SCRATCH_ROOT (P4-04),
# MEDIA_ROOT is also where a clip stages while it uploads, so this already covers that
# scratch directory too. 1 GB is a floor for a single small box, not a sizing
# recommendation — size it from a load test on real traffic.
MIN_FREE_DISK_BYTES=1000000000
# What the server runs at shutdown to checkpoint the WAL into the main database file:
# `truncate` (the default), `passive`, or `none`. Left at `truncate` here on purpose —
# this instance runs no Litestream, so there is no reader for `passive` to avoid
# blocking on, and `truncate` is what keeps a copy of the `.sqlite` file self-contained.
# SQLITE_SHUTDOWN_CHECKPOINT=truncate

# --- Upload limits -----------------------------------------------------------
# Uploads are buffered in memory, never on disk: the ingest pipeline re-encodes every
# byte it accepts, so staging a temp file would be a write and a read for nothing — and
# 1.0 leaked those files on its failure paths. What that choice costs is RAM, and it is
# the container's memory limit (`deploy.resources.limits.memory` in compose.yaml, 2 GB)
# that has to cover it, not disk.
#
# Three bounds apply, and only the first two are variables:
#   MAX_UPLOAD_BYTES       the largest single photo
#   MAX_FILES_PER_UPLOAD   how many may arrive in one request
#   150 MB                 the total one request may hold, across all of its files,
#                          enforced while the body is read (guestRoutes.ts). Without it
#                          the product of the two above was the real bound — 500 MB for
#                          one request at these defaults.
#
# So raising MAX_FILES_PER_UPLOAD no longer raises what a request costs in memory.
# Raising MAX_UPLOAD_BYTES does: the per-request total is never lower than one file you
# said was acceptable, so a 400 MB MAX_UPLOAD_BYTES is a 400 MB request. Raise the
# container's memory limit with it, or do not raise it.
MAX_UPLOAD_BYTES=25000000
MAX_FILES_PER_UPLOAD=20
# Rejected before decode: a 100-megapixel file is a decompression bomb, not a photo.
MAX_IMAGE_PIXELS=50000000
# Default per-event storage quota. Uploads stop when it is reached instead of
# filling the disk.
DEFAULT_EVENT_QUOTA_BYTES=5000000000
# Box-wide ceiling on quotaBytes (roadmap §10.5 / G3-02): nobody's POST /api/events may
# ask for more than this, host or operator alike, and a request that does is refused
# with 400 event.quotaAboveCeiling rather than silently clamped. Blank means no
# ceiling beyond the domain's own "a positive integer" — the behaviour every
# self-hosted box has always had, so leave this unset unless this box is run for
# other people. Must be at least DEFAULT_EVENT_QUOTA_BYTES, or the box refuses to
# boot.
MAX_EVENT_QUOTA_BYTES=
# How many upload requests — photos and clips together, one shared bucket — may be in
# flight at once, process-wide (G3-06 / P4-10). Past it: 429 upload.busy with a short
# Retry-After. A slot is held from admission to response, spanning both the buffering
# (150 MB per request, above) and the sharp decode after it (~200 MB) — four in flight
# at the default is ~1.4 GB, not 600 MB of buffers alone, and that full figure is what
# this container's memory limit actually has to cover. See compose.yaml's budget comment.
MAX_CONCURRENT_UPLOAD_REQUESTS=4

# --- Short video clips -------------------------------------------------------
# Clips have their own limit and it is deliberately **not** MAX_UPLOAD_BYTES. Raising
# that one raises the 150 MB per-request heap ceiling described above, which the
# container's memory limit was reasoned against; a clip does not need that budget
# anyway, because it streams to disk rather than to the heap, one file per request.
# Fifteen seconds off a modern phone is 20-60 MB.
MAX_CLIP_BYTES=80000000
# The duration cap, enforced twice: refused at the probe and passed to the encoder as a
# hard bound, because a truncated container's header is a claim by the file rather than
# a fact. 1 to 120 seconds; the product is written around 5 to 15.
MAX_CLIP_SECONDS=15
# The projected height. 720p reads well at three metres and encodes quickly; 1080 costs
# roughly twice the CPU per clip on the single worker that drains the queue.
CLIP_MAX_HEIGHT=720
# The decompression bomb control for video, judged from the probed header before a frame
# is decoded — the counterpart of MAX_IMAGE_PIXELS. CLIP_MAX_HEIGHT is not one: it scales
# the *output*, and the filter that does it runs after the decoder has already allocated
# the frame, so a valid 16000x16000 HEVC is 380 MB per frame and an OOM kill. The default
# admits 8K UHD (7680x4320).
MAX_CLIP_PIXELS=33177600
# How many clips may be waiting or transcoding across the whole box before an upload is
# answered `429 clip.queueFull` with a `Retry-After`. Process-wide, because one worker
# at concurrency 1 drains the queue for every event — the wait a guest actually
# experiences is the global one. **Never answered as the quota's 413**: that tells a
# guest in French that the gallery is full and to find the organiser, for a condition
# that clears in ninety seconds.
MAX_QUEUED_CLIPS=20
# The same backpressure, scoped to one event, checked in the same transaction as the
# box-wide count above. On a box running one event at a time — the only deployment this
# number changes anything for by default — the two are reached together and nothing is
# observable. Lower this only if several events share this box and one of them filling
# the box-wide queue must not make the others wait behind it.
MAX_QUEUED_CLIPS_PER_EVENT=20
# Where ffmpeg is, when it is not simply on PATH. Leave both empty for the ordinary
# case: the Docker image installs ffmpeg from apt, and a source checkout falls back to
# the `ffmpeg-static` / `ffprobe-static` devDependencies that `npm ci` brings.
#
# A path that is set and wrong is a **refusal**, not a fallback: an operator who set
# this wanted that build, and quietly using another one is how a deployment ends up
# encoding with something nobody chose. The server still starts — clip uploads are
# refused with a named code, photos are unaffected, and `/api/ready` reports
# `video: unavailable` as a detail without failing the probe.
FFMPEG_PATH=
FFPROBE_PATH=

# --- Retention ---------------------------------------------------------------
# How often the server sweeps events whose retention period has expired and deletes
# them, photos and all. 1 to 1440 minutes, or the word `off`.
#
# There is no numeric way to disable this: `0` and an empty value are refused at boot.
# A retention period is a promise made to guests, and a dangling
# `RETENTION_SWEEP_INTERVAL_MINUTES=` quietly breaking it is the one failure whose only
# symptom is that nothing happens. Set `off` only if a cron or systemd timer runs
# `npm run purge` instead — otherwise nothing deletes anything, ever.
RETENTION_SWEEP_INTERVAL_MINUTES=60

# How many days the audit log keeps a row (docs/ROADMAP.md §10.8). 365 to 3650. It records
# who changed a client's ceilings and, as later items land, every other operator action;
# it is empty on a box that is not run for other people (SITE_ADMIN=off).
#
# **365 is the floor**: a shorter log would forget an action while the client it concerned
# may still dispute it, so anything below it stops the boot and names this variable. The
# hosted instance runs 365. An empty value means the default.
#
# Rows are removed by the same sweep as RETENTION_SWEEP_INTERVAL_MINUTES, so with that set to
# `off` nothing prunes the audit log.
AUDIT_RETENTION_DAYS=1095

# --- Scheduled opening and closing -------------------------------------------
# How often the server opens the events whose scheduled opening has passed and closes
# the ones whose scheduled closing has passed. 1 to 1440 minutes, or the word `off`.
#
# Same rule as above: `0` and an empty value are refused at boot, because a dangling
# `SCHEDULE_SWEEP_INTERVAL_MINUTES=` would leave a host with two fields they can set and
# nothing that ever acts on them. Five minutes by default, because the lag is visible in
# the room — an event scheduled for 18:00 opens somewhere in 18:00-18:05, and a guest
# scanning the QR code before it does is told the party has not started.
#
# A missed window is still honoured: if the server was down at 18:00, the next sweep
# opens the event. Nothing here deletes anything — closing an event keeps its photos,
# and the retention setting above is the only thing that removes them.
#
# `off` stops the sweep applying schedules; it does not stop hosts setting them. Instants
# keep being stored while it is off and nothing acts on them, so they pile up in the past,
# and the first sweep after you turn it back on applies the whole backlog at once — which
# can reopen an event you closed by hand, clearing the closing time that starts its
# retention clock. Clear the schedules of any affected event before re-enabling it.
SCHEDULE_SWEEP_INTERVAL_MINUTES=5

# --- Guest behaviour ---------------------------------------------------------
# How long a guest may delete their own photo after sending it.
GUEST_SELF_DELETE_GRACE_SECONDS=900
# Public write endpoints, per IP.
UPLOAD_RATE_LIMIT_PER_MINUTE=12
JOIN_RATE_LIMIT_PER_MINUTE=20
# Login attempts, combined with BCRYPT_COST to put online guessing out of reach.
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Reactions are cheap but tappable at speed; the per-event domain budget is the finer
# control, this is only the per-IP backstop.
REACTION_RATE_LIMIT_PER_MINUTE=30
# How many events one account may create per hour. Per account, not per IP: an office
# or a venue's guest Wi-Fi is one address shared by several hosts, and one host's burst
# must not spend a colleague's allowance.
EVENT_CREATION_RATE_LIMIT_PER_HOUR=20
# The shared gallery link: its pages (and password unlocks) and its bytes per IP per
# minute — sized for a household or an office behind one address — and failed password
# attempts per IP and per link per fifteen minutes.
GALLERY_RATE_LIMIT_PER_MINUTE=120
GALLERY_MEDIA_RATE_LIMIT_PER_MINUTE=3000
GALLERY_UNLOCK_ATTEMPTS_PER_CLIENT=10
GALLERY_UNLOCK_ATTEMPTS_PER_LINK=50

# --- Server-sent events -------------------------------------------------------
# Concurrency, not a rate: how many event streams one client key may hold open at the
# same time, and how many the process serves at once across every client and event. Only
# the wall and the moderation console open one each; guests hold none. The per-client
# figure is headroom for a reload overlapping the connection it replaces, and the
# box-wide one is the backstop for a leak or a botnet rather than honest use.
MAX_STREAMS_PER_CLIENT=12
MAX_STREAMS_TOTAL=500
# The event bus's own cap, one level under the two above: how many SSE subscriptions a
# single event may hold before a fresh one is refused with 503.
MAX_SUBSCRIBERS_PER_EVENT=200

# --- First-run bootstrap -----------------------------------------------------
# Creates the first owner account on an empty database, then is ignored. There is no
# default admin/password in 2.0.
#
# That first account is also this box's **operator** — the site-level role, for someone
# running one instance for several clients. It is not a super-user: it grants nothing
# inside any event, so on a box you run for yourself it changes nothing you can observe.
# See docs/SECURITY.md §2 and docs/ROADMAP.md §10.
#
# Set both or neither: an email without a password creates no account, and the server
# says so at boot rather than logging it and carrying on. The password must satisfy the
# same policy as any account password — at least 12 characters, and not a guessable one
# — and the server refuses to boot if it does not, so a mistyped bootstrap is a named
# error at startup instead of a login form that rejects you later. An empty value means
# "not set", which is what `docker compose up` sends when you leave these out.
# BOOTSTRAP_OWNER_EMAIL=host@example.com
# BOOTSTRAP_OWNER_PASSWORD=

# --- Site administration -----------------------------------------------------
# `on` only if you run this box for other people — a photographer, an agency, a venue
# handing each client their own evening. It mounts the operator's namespace, /api/site,
# where the clients, invitations and ceilings of docs/ROADMAP.md §10 will live; today it
# carries no screen at all, only the gate every one of them will sit behind. Every route
# there is refused to anybody who is not the operator — the site role described above —
# and, like that role, it grants nothing inside anybody's event.
#
# `off` by default, and a box you run for yourself needs nothing here. Off, those paths
# are not mounted at all: they answer exactly what a path nobody wrote answers, so a solo
# box exposes no operator surface. The setting itself is no secret — on, those paths
# refuse a stranger with 401 where off answers 404. Migrations run the same in both modes,
# so turning it on later — or off and on again — loses nothing.
#
# Exactly `off` or `on`, lower case. Anything else (`true`, `1`, `ON`) stops the boot and
# names this variable; an empty value means "not set", which is `off`.
SITE_ADMIN=off

# --- Source code (AGPL section 13) ---------------------------------------------
# EventSlide is AGPL-3.0-only. Section 13 obliges a network service to offer the source of
# the version it runs to the people using it, so every guest and host screen carries a
# "Code source" link and `GET /api/about` publishes the same address. There is no setting
# that removes it, on purpose: you can change where it points, never whether it is shown.
#
# Unset, it points at the upstream tag of the running version
# (https://github.com/Irony42/EventSlide/tree/v<version>), which is exactly right when you
# run an unmodified copy of that tagged release. Set SOURCE_CODE_URL when you run anything
# else — a modified build, a fork, or a build of a commit no tag names — to the page where
# that build's source is published. An https URL and nothing else: javascript:, data: and plain
# http: are refused at boot, as is a URL with credentials in it.
# SOURCE_CODE_URL=https://git.example.org/me/eventslide/tree/my-release
#
# SOURCE_REF is the Docker build argument behind the same link (`docker build --build-arg
# SOURCE_REF=<tag-or-commit> .`), which the image bakes in as this variable. It is only for
# an UNMODIFIED upstream tag or commit — it always points into the upstream repository, so for
# anything modified it would offer code that lacks the modification; use SOURCE_CODE_URL.
# It is for whoever builds the image, not for a .env file.

# --- Who may create an event (P3-05 / D-07) ----------------------------------------
# `anyAccount` (the default, and how every box has always worked): any signed-in account
# may create events, a moderator somebody invited included. `clientMembers`: only an
# account that belongs to a client may, plus the box's operator; any other account is
# refused 403 event.creationNotAllowed. A member's event is attached to their client, and
# the client's event ceilings (docs/ROADMAP.md §10.5) count it.
#
# `clientMembers` is a policy only an operator can satisfy — nobody can create a client on
# a box with no operator surface — so it REQUIRES SITE_ADMIN=on and the boot stops, naming
# this variable, without it (roadmap §10.9: an operator-only setting is refused when the
# mode is off, rather than silently ignored). Exactly `anyAccount` or `clientMembers`;
# an empty value means "not set".
#
# Until the operator API ships (docs/ROADMAP.md §10.2: nothing over HTTP creates a client or
# adds a member to one yet), setting `clientMembers` leaves the operator as the only account
# that can create an event. Leave it at `anyAccount` until you can enrol your clients.
EVENT_CREATION=anyAccount

# --- Support links (optional, empty by default) --------------------------------
# DONATION_URL and BUDGET_URL are for an instance run for other people that asks to be
# supported. Leave both empty — they are empty unless you set them — and nothing about money
# appears anywhere on your box.
#
# Set, DONATION_URL puts a discreet "Soutenir le projet" link in the footer of the host
# screens and on /about, and shows each host a single card they can close on the page of an
# event after it is closed (closing it is remembered in their browser, for that event). It is
# NEVER shown on a guest screen (join, upload, shared gallery) or on the projected wall;
# /about, which anyone may open, carries it. BUDGET_URL is the public ledger the donations are
# accounted in, shown beside it on /about and in the card.
#
# A donation unlocks nothing: there is no perk, no badge and no priority, and no setting adds
# one. The screens that carry the link say so in as many words.
#
# https URLs and nothing else, checked like SOURCE_CODE_URL: javascript:, data: and plain
# http: are refused at boot, as is a URL with credentials in it. Both are published by
# GET /api/about as links.donate and links.budget, and only when set.
# DONATION_URL=https://opencollective.com/your-collective
# BUDGET_URL=https://opencollective.com/your-collective/budget

# --- Slugs and join codes (P4-09 / D-14) -------------------------------------
# The three defaults below reproduce 2.0's only behaviour exactly: a self-hosted box
# that never sets any of them is unchanged by this. A hosted instance serving strangers
# sets EVENT_SLUG_SUFFIX=random, ALLOW_CUSTOM_SLUGS=false and JOIN_CODE_LENGTH=8.
#
# `none` or `random`. `none` means a derived slug (the host left the field blank) is the
# bare folded name, camille-sacha — what every event created before this variable
# existed has. `random` always appends a random, lowercase Crockford suffix to a
# derived slug, camille-sacha-h7k2qm, never only on collision: a sequential fallback
# (camille-sacha-2) would prove the bare slug exists, which is exactly the enumeration
# oracle this variable exists to close (docs/SECURITY.md).
EVENT_SLUG_SUFFIX=none
# Whether a caller may address their own event by a slug they chose, instead of one
# derived from the name. `true` keeps the host-facing form's slug field working exactly
# as it always has. `false` refuses a supplied slug outright (400
# event.customSlugNotAllowed) rather than silently ignoring it.
ALLOW_CUSTOM_SLUGS=true
# How many characters a newly minted or rotated join code has, 6 to 10. Six is every
# pre-existing printed card's length; raising this only affects codes minted after the
# change; existing codes keep working.
JOIN_CODE_LENGTH=6

# --- Tests only --------------------------------------------------------------
# Enables the ?e2e_interval / ?e2e_transition display hooks. Never set in production.
# E2E_HOOKS=0
