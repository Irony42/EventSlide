# EventSlide configuration.
#
# Copy to `.env` and fill in. Everything here is parsed and validated once by
# src/infrastructure/config/env.ts; nothing else in the codebase reads process.env.
# The server refuses to boot in production if a required secret is missing or weak —
# that refusal is deliberate, do not work around it.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4300
# Public origin, used to build join links and QR codes. Must be the URL a guest's
# phone can actually reach — not localhost, if the phone is on the venue Wi-Fi.
PUBLIC_URL=http://localhost:5173
LOG_LEVEL=debug

# --- Secrets -----------------------------------------------------------------
# Both are required in production and must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-in-production-at-least-32-characters
# Signs the event-scoped guest device cookie. Rotating it invalidates every guest
# session, which is the emergency lever if a join link leaks widely.
GUEST_TOKEN_SECRET=change-me-too-at-least-32-characters-long

# --- Cookies -----------------------------------------------------------------
# Leave unset to follow NODE_ENV. Set to true only behind HTTPS, or hosts will be
# unable to log in.
# SESSION_COOKIE_SECURE=false
# Number of reverse proxies in front of the app. 0 when exposed directly; 1 behind a
# single nginx or Caddy. Wrong values break per-IP rate limiting.
TRUST_PROXY_HOPS=0

# --- Storage -----------------------------------------------------------------
DATABASE_PATH=./data/eventslide.sqlite
MEDIA_ROOT=./media

# --- Upload limits -----------------------------------------------------------
# Uploads are buffered in memory, never on disk: the ingest pipeline re-encodes every
# byte it accepts, so staging a temp file would be a write and a read for nothing — and
# 1.0 leaked those files on its failure paths. What that choice costs is RAM, and it is
# the container's memory limit (`deploy.resources.limits.memory` in compose.yaml, 1 GB)
# that has to cover it, not disk.
#
# Three bounds apply, and only the first two are variables:
#   MAX_UPLOAD_BYTES       the largest single photo
#   MAX_FILES_PER_UPLOAD   how many may arrive in one request
#   150 MB                 the total one request may hold, across all of its files,
#                          enforced while the body is read (guestRoutes.ts). Without it
#                          the product of the two above was the real bound — 500 MB for
#                          one request at these defaults.
#
# So raising MAX_FILES_PER_UPLOAD no longer raises what a request costs in memory.
# Raising MAX_UPLOAD_BYTES does: the per-request total is never lower than one file you
# said was acceptable, so a 400 MB MAX_UPLOAD_BYTES is a 400 MB request. Raise the
# container's memory limit with it, or do not raise it.
MAX_UPLOAD_BYTES=25000000
MAX_FILES_PER_UPLOAD=20
# Rejected before decode: a 100-megapixel file is a decompression bomb, not a photo.
MAX_IMAGE_PIXELS=50000000
# Default per-event storage quota. Uploads stop when it is reached instead of
# filling the disk.
DEFAULT_EVENT_QUOTA_BYTES=5000000000

# --- Short video clips -------------------------------------------------------
# Clips have their own limit and it is deliberately **not** MAX_UPLOAD_BYTES. Raising
# that one raises the 150 MB per-request heap ceiling described above, which the
# container's memory limit was reasoned against; a clip does not need that budget
# anyway, because it streams to disk rather than to the heap, one file per request.
# Fifteen seconds off a modern phone is 20-60 MB.
MAX_CLIP_BYTES=80000000
# The duration cap, enforced twice: refused at the probe and passed to the encoder as a
# hard bound, because a truncated container's header is a claim by the file rather than
# a fact. 1 to 120 seconds; the product is written around 5 to 15.
MAX_CLIP_SECONDS=15
# The projected height. 720p reads well at three metres and encodes quickly; 1080 costs
# roughly twice the CPU per clip on the single worker that drains the queue.
CLIP_MAX_HEIGHT=720
# How many clips may be waiting or transcoding across the whole box before an upload is
# answered `429 clip.queueFull` with a `Retry-After`. Process-wide, because one worker
# at concurrency 1 drains the queue for every event — the wait a guest actually
# experiences is the global one. **Never answered as the quota's 413**: that tells a
# guest in French that the gallery is full and to find the organiser, for a condition
# that clears in ninety seconds.
MAX_QUEUED_CLIPS=20
# Where ffmpeg is, when it is not simply on PATH. Leave both empty for the ordinary
# case: the Docker image installs ffmpeg from apt, and a source checkout falls back to
# the `ffmpeg-static` / `ffprobe-static` devDependencies that `npm ci` brings.
#
# A path that is set and wrong is a **refusal**, not a fallback: an operator who set
# this wanted that build, and quietly using another one is how a deployment ends up
# encoding with something nobody chose. The server still starts — clip uploads are
# refused with a named code, photos are unaffected, and `/api/ready` reports
# `video: unavailable` as a detail without failing the probe.
FFMPEG_PATH=
FFPROBE_PATH=

# --- Retention ---------------------------------------------------------------
# How often the server sweeps events whose retention period has expired and deletes
# them, photos and all. 1 to 1440 minutes, or the word `off`.
#
# There is no numeric way to disable this: `0` and an empty value are refused at boot.
# A retention period is a promise made to guests, and a dangling
# `RETENTION_SWEEP_INTERVAL_MINUTES=` quietly breaking it is the one failure whose only
# symptom is that nothing happens. Set `off` only if a cron or systemd timer runs
# `npm run purge` instead — otherwise nothing deletes anything, ever.
RETENTION_SWEEP_INTERVAL_MINUTES=60

# --- Scheduled opening and closing -------------------------------------------
# How often the server opens the events whose scheduled opening has passed and closes
# the ones whose scheduled closing has passed. 1 to 1440 minutes, or the word `off`.
#
# Same rule as above: `0` and an empty value are refused at boot, because a dangling
# `SCHEDULE_SWEEP_INTERVAL_MINUTES=` would leave a host with two fields they can set and
# nothing that ever acts on them. Five minutes by default, because the lag is visible in
# the room — an event scheduled for 18:00 opens somewhere in 18:00-18:05, and a guest
# scanning the QR code before it does is told the party has not started.
#
# A missed window is still honoured: if the server was down at 18:00, the next sweep
# opens the event. Nothing here deletes anything — closing an event keeps its photos,
# and the retention setting above is the only thing that removes them.
#
# `off` stops the sweep applying schedules; it does not stop hosts setting them. Instants
# keep being stored while it is off and nothing acts on them, so they pile up in the past,
# and the first sweep after you turn it back on applies the whole backlog at once — which
# can reopen an event you closed by hand, clearing the closing time that starts its
# retention clock. Clear the schedules of any affected event before re-enabling it.
SCHEDULE_SWEEP_INTERVAL_MINUTES=5

# --- Guest behaviour ---------------------------------------------------------
# How long a guest may delete their own photo after sending it.
GUEST_SELF_DELETE_GRACE_SECONDS=900
# Public write endpoints, per IP.
UPLOAD_RATE_LIMIT_PER_MINUTE=12
JOIN_RATE_LIMIT_PER_MINUTE=20

# --- First-run bootstrap -----------------------------------------------------
# Creates the first owner account on an empty database, then is ignored. There is no
# default admin/password in 2.0.
#
# Set both or neither: an email without a password creates no account, and the server
# says so at boot rather than logging it and carrying on. The password must satisfy the
# same policy as any account password — at least 12 characters, and not a guessable one
# — and the server refuses to boot if it does not, so a mistyped bootstrap is a named
# error at startup instead of a login form that rejects you later. An empty value means
# "not set", which is what `docker compose up` sends when you leave these out.
# BOOTSTRAP_OWNER_EMAIL=host@example.com
# BOOTSTRAP_OWNER_PASSWORD=

# --- Tests only --------------------------------------------------------------
# Enables the ?e2e_interval / ?e2e_transition display hooks. Never set in production.
# E2E_HOOKS=0
